{
  "name": "@x-intelligence/collector",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "x:auth": "tsx src/auth/login.ts",
    "x:auth:test": "tsx --test src/auth/state.test.ts ../../packages/x/src/twitter-monitor/login.test.ts",
    "x:collect:probe": "tsx src/jobs/probe-cli.ts",
    "x:collect:test": "tsx --test ../../packages/x/src/twitter-monitor/*.test.ts src/jobs/*.test.ts src/auth/credentials.test.ts"
  },
  "dependencies": {
    "@x-intelligence/classifier": "workspace:*",
    "@x-intelligence/shared": "workspace:*",
    "@x-intelligence/x": "workspace:*",
    "next": "16.3.8",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15"
  }
}
