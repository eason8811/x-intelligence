{
  "name": "x-intelligence",
  "private": true,
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @x-intelligence/db db:generate",
    "db:check": "pnpm --filter @x-intelligence/db db:check",
    "db:migrate": "pnpm --filter @x-intelligence/db db:migrate",
    "x:auth": "pnpm --filter @x-intelligence/collector x:auth",
    "x:auth:test": "pnpm --filter @x-intelligence/collector x:auth:test",
    "x:collect:probe": "pnpm --filter @x-intelligence/collector x:collect:probe",
    "x:collect:test": "pnpm --filter @x-intelligence/collector x:collect:test"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
