# Server-side configuration only. Never use NEXT_PUBLIC_ for secrets.
DATABASE_URL=
# Generate a stable secret with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
JEV_API_KEY=
JEV_MODEL=jev-1.14.0
CRON_SECRET=
# Base64 encoding of a random 32-byte key; keep it outside PostgreSQL.
X_AUTH_ENCRYPTION_KEY=
# X account binding runs inside the long-running Collector service.
# Generate with: openssl rand -base64 32
COLLECTOR_INTERNAL_TOKEN=
COLLECTOR_BROWSER_HOST=127.0.0.1
COLLECTOR_BROWSER_PORT=3002
# Web server to Collector's private HTTP endpoint. Do not expose this URL publicly.
COLLECTOR_BROWSER_INTERNAL_URL=http://127.0.0.1:3002
# Public WebSocket endpoint routed to the Collector browser service.
COLLECTOR_BROWSER_WS_URL=ws://127.0.0.1:3002/ws
# Comma-separated exact Web app origins allowed to open the browser stream.
X_ACCOUNT_BINDING_ALLOWED_ORIGINS=http://localhost:3000
